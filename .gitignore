# IDE
.idea/
.vscode/
*.swp
*.swo

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
venv/
.venv/
.pytest_cache/
.mypy_cache/

# RapiDAST (cloned by --download-rapidast)
rapidast/

# OOBTKUBE results (automate_dast_scan.py)
oobtkube-op/

# ZAP results (Podman RapiDAST)
zap-op/

# Exported CRs from cluster (Cr-Configs/<operator>/*.yaml)
Cr-Configs/

# GCS credentials (never commit)
rapidast-sa-*.json
*_key.json
*.pem
.env
.env.*

# Kubeconfig (may contain tokens)
*.kubeconfig

# Local / example configs (user-created, may contain secrets)
config/oobtkube/example-operator.yaml

# Debug / temp files
run_all_err.txt
*.err

# ZAP scan configs (may contain bearer tokens / API keys — never commit)
config/zap/
