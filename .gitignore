# IDE
.idea/
.vscode/
*.swp
*.swo

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
venv/
.venv/
.pytest_cache/
.mypy_cache/

# RapiDAST (cloned by --download-rapidast)
rapidast/

# All scan results (OOBTKUBE + ZAP flat + RapiDAST trees)
results/

# Pre-unification result dirs (optional local cleanup; do not commit)
oobtkube-op/
zap-op/

# Exported CRs from cluster (oobtkube-config/<operator>/*.yaml)
oobtkube-config/
!oobtkube-config/README.md

# GCS credentials (never commit)
secrets/
*_key.json
rapidast-sa-operators-*.json
*.pem
.env
.env.*

# Runtime ZAP configs with injected tokens (normally in /tmp, but just in case)
zap-runtime-*/

# Kubeconfig (may contain tokens)
*.kubeconfig

# Local / example configs (user-created, may contain secrets)
config/operators/example/oobtkube.yaml

# Debug / temp files
run_all_err.txt
*.err

